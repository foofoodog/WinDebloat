<Window x:Class="WinDebloat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WinDebloat.ViewModels"
        mc:Ignorable="d"
        Title="Windows Debloat &amp; RAM Optimizer" 
        Height="820" Width="1060"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TabHeaderUnselectedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabHeaderHoverBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TabHeaderHoverForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TabHeaderSelectedBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource TabHeaderSelectedBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card DataTemplate for Items -->
        <DataTemplate x:Key="DebloatItemTemplate">
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,10" 
                    Padding="14,12"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Checkbox -->
                    <CheckBox IsChecked="{Binding IsSelected}" 
                              VerticalAlignment="Center" 
                              Margin="0,0,14,0">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <!-- Information Stack -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Title}" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <!-- Recommended Tag -->
                            <Border Background="{DynamicResource TagRecommendedBackgroundBrush}" 
                                    BorderBrush="{DynamicResource TagRecommendedBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    Margin="10,0,0,0"
                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="RECOMMENDED" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TagRecommendedForegroundBrush}"/>
                            </Border>

                            <!-- Admin Tag -->
                            <Border Background="{DynamicResource TagAdminBackgroundBrush}" 
                                    BorderBrush="{DynamicResource TagAdminBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    Margin="8,0,0,0"
                                    Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="ADMIN" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TagAdminForegroundBrush}"/>
                            </Border>

                            <!-- Reboot Required Tag -->
                            <Border Background="{DynamicResource TagRebootBackgroundBrush}" 
                                    BorderBrush="{DynamicResource TagRebootBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    Margin="8,0,0,0"
                                    Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="REBOOT NEEDED" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TagRebootForegroundBrush}"/>
                            </Border>

                            <!-- Bloatware Tag -->
                            <Border Background="{DynamicResource TagBloatwareBackgroundBrush}" 
                                    BorderBrush="{DynamicResource TagBloatwareBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    Margin="8,0,0,0"
                                    Visibility="{Binding IsBloatware, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="BLOATWARE" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TagBloatwareForegroundBrush}"/>
                            </Border>

                            <!-- Startup Status Tag -->
                            <Border Background="{DynamicResource TagStartupBackgroundBrush}" 
                                    BorderBrush="{DynamicResource TagStartupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    Margin="8,0,0,0"
                                    Visibility="{Binding HasStartupStatus, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StartupStatus}" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TagStartupForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontSize="13" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,2"/>

                        <TextBlock Text="{Binding Details}" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   FontSize="11" 
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- RAM Savings & Status -->
                    <StackPanel Grid.Column="2" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Right" 
                                Margin="12,0,0,0">
                        <Border Background="{DynamicResource RamBadgeBackgroundBrush}" 
                                BorderBrush="{DynamicResource RamBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6" 
                                Padding="8,4" 
                                HorizontalAlignment="Right">
                            <TextBlock Text="{Binding EstimatedMemory}" 
                                       Foreground="{DynamicResource RamBadgeForegroundBrush}" 
                                       FontWeight="SemiBold" 
                                       FontSize="11"/>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   FontSize="11" 
                                   HorizontalAlignment="Right" 
                                   Margin="0,4,0,0"/>

                        <Button Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="View feature details, technical effects, consequences, and documentation link"
                                Background="{DynamicResource TrimButtonBackgroundBrush}" 
                                Foreground="{DynamicResource TrimButtonForegroundBrush}" 
                                BorderBrush="{DynamicResource TrimButtonBorderBrush}" 
                                BorderThickness="1" 
                                FontWeight="SemiBold" 
                                FontSize="11" 
                                Padding="8,3" 
                                Margin="0,6,0,0"
                                HorizontalAlignment="Right"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                            </Button.Resources>
                            <TextBlock Text="ℹ️ Details"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Revert Item Template for Undo Tab -->
        <DataTemplate x:Key="RevertItemTemplate">
            <Border Background="{DynamicResource CardBackgroundBrush}" 
                    BorderBrush="{DynamicResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,10" 
                    Padding="14,12"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Checkbox for bulk revert -->
                    <CheckBox IsChecked="{Binding IsSelected}" 
                              VerticalAlignment="Center" 
                              Margin="0,0,14,0">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <!-- Information Stack -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Title}" 
                                       FontWeight="Bold" 
                                       FontSize="15" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                            <!-- Status Badge -->
                            <Border Background="{DynamicResource TagBloatwareBackgroundBrush}" 
                                    BorderBrush="{DynamicResource TagBloatwareBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    Margin="10,0,0,0">
                                <TextBlock Text="APPLIED" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource TagBloatwareForegroundBrush}"/>
                            </Border>

                            <!-- Category Badge -->
                            <Border Background="{DynamicResource ControlBackgroundBrush}" 
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" 
                                    Padding="6,2" 
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding Category}" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource ControlForegroundBrush}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontSize="13" 
                                   TextWrapping="Wrap" 
                                   Margin="0,0,0,2"/>

                        <TextBlock Text="{Binding Details}" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   FontSize="11" 
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Revert Action & Status -->
                    <StackPanel Grid.Column="2" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Right" 
                                Margin="12,0,0,0">
                        <Button Command="{Binding DataContext.UndoItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Content="↩️ Revert Change" 
                                Background="{DynamicResource ControlBackgroundBrush}" 
                                Foreground="{DynamicResource RamBadgeForegroundBrush}" 
                                BorderBrush="{DynamicResource ProgressBarFillBrush}" 
                                BorderThickness="1" 
                                FontWeight="Bold" 
                                FontSize="12" 
                                Padding="12,6" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="View feature details, technical effects, and consequences"
                                Background="{DynamicResource TrimButtonBackgroundBrush}" 
                                Foreground="{DynamicResource TrimButtonForegroundBrush}" 
                                BorderBrush="{DynamicResource TrimButtonBorderBrush}" 
                                BorderThickness="1" 
                                FontWeight="SemiBold" 
                                FontSize="11" 
                                Padding="8,3" 
                                Margin="0,5,0,0" 
                                HorizontalAlignment="Right"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                            </Button.Resources>
                            <TextBlock Text="ℹ️ Details"/>
                        </Button>
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="{DynamicResource TextMutedBrush}" 
                                   FontSize="11" 
                                   HorizontalAlignment="Right" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Stern Warning Banner -->
            <RowDefinition Height="Auto" />
            <!-- RAM Monitor Card -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Tabs -->
            <RowDefinition Height="*" />
            <!-- Bottom Control Bar -->
            <RowDefinition Height="Auto" />
            <!-- Log Console -->
            <RowDefinition Height="140" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="Windows Debloat &amp; RAM Optimizer" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Free memory and disable unnecessary background apps and services" 
                           FontSize="13" 
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Admin Status Badge -->
                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="10,6" 
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️ " FontSize="12"/>
                        <TextBlock Text="{Binding AdminBadgeText}" 
                                   FontWeight="SemiBold" 
                                   FontSize="12" 
                                   Foreground="{DynamicResource RamBadgeForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Relaunch as Admin Button -->
                <Button Command="{Binding RelaunchAdminCommand}" 
                        Content="🛡️ Relaunch as Admin" 
                        Background="{DynamicResource TagAdminBackgroundBrush}" 
                        Foreground="{DynamicResource TagAdminForegroundBrush}" 
                        BorderBrush="{DynamicResource TagAdminBorderBrush}"
                        BorderThickness="1" 
                        FontWeight="SemiBold" 
                        Padding="12,6" 
                        Margin="0,0,10,0" 
                        Cursor="Hand"
                        Visibility="{Binding IsNotAdmin, Converter={StaticResource BoolToVis}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Refresh Button -->
                <Button Command="{Binding RefreshCommand}" 
                        Content="🔄 Refresh Scan" 
                        Background="{DynamicResource ControlBackgroundBrush}" 
                        Foreground="{DynamicResource ControlForegroundBrush}" 
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1" 
                        FontWeight="SemiBold" 
                        Padding="14,6" 
                        Margin="0,0,10,0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Theme Toggle Button -->
                <Button Command="{Binding ToggleThemeCommand}" 
                        Content="{Binding ThemeToggleText}" 
                        ToolTip="{Binding ThemeToggleToolTip}"
                        Background="{DynamicResource ControlBackgroundBrush}" 
                        Foreground="{DynamicResource ControlForegroundBrush}" 
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1" 
                        FontWeight="SemiBold" 
                        Padding="12,6" 
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Stern System Integrity Warning Banner -->
        <Border Grid.Row="1" 
                Background="{DynamicResource WarningBannerBackgroundBrush}" 
                BorderBrush="{DynamicResource WarningBannerBorderBrush}" 
                BorderThickness="3,1,1,1" 
                CornerRadius="8" 
                Padding="14,10" 
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🚨" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="USE AT YOUR OWN RISK — SYSTEM INTEGRITY WARNING" 
                               FontWeight="Bold" 
                               FontSize="13" 
                               Foreground="{DynamicResource WarningBannerTitleBrush}"/>
                    <TextBlock Text="Modifying core Windows components, disabling system services, or removing packages can cause system instability, break functionality, or brick your machine. Create a System Restore Point before making changes." 
                               FontWeight="Normal" 
                               FontSize="12" 
                               Foreground="{DynamicResource WarningBannerTextBrush}" 
                               TextWrapping="Wrap" 
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" 
                        Command="{Binding CreateRestorePointCommand}" 
                        Content="🛡️ Create Restore Point" 
                        Background="{DynamicResource TagAdminBackgroundBrush}" 
                        Foreground="{DynamicResource TagAdminForegroundBrush}" 
                        BorderBrush="{DynamicResource TagAdminBorderBrush}" 
                        BorderThickness="1" 
                        FontWeight="SemiBold" 
                        FontSize="12" 
                        Padding="12,7" 
                        Cursor="Hand" 
                        VerticalAlignment="Center" 
                        Margin="12,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- RAM Monitor Card -->
        <Border Grid.Row="2" 
                Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource CardBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="16,12" 
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧠 Physical Memory Usage" 
                                   FontWeight="SemiBold" 
                                   FontSize="15" 
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Command="{Binding TrimRamCommand}"
                                ToolTip="Flush idle process working sets to reclaim dormant physical RAM"
                                Background="{DynamicResource TrimButtonBackgroundBrush}" 
                                Foreground="{DynamicResource TrimButtonForegroundBrush}" 
                                BorderBrush="{DynamicResource TrimButtonBorderBrush}" 
                                BorderThickness="1" 
                                FontWeight="SemiBold" 
                                FontSize="11" 
                                Padding="8,3" 
                                Margin="14,0,0,0"
                                Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                            </Button.Resources>
                            <TextBlock Text="🧹 Trim Working Set"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Used: " Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding MemoryUsedGB, StringFormat='{}{0:F2} GB'}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                        <TextBlock Text="  |  Free: " Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding MemoryAvailableGB, StringFormat='{}{0:F2} GB'}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                        <TextBlock Text="  |  Total: " Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding MemoryTotalGB, StringFormat='{}{0:F2} GB'}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                        <TextBlock Text=" (" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding MemoryPercent, StringFormat='{}{0}%'}" FontWeight="Bold" Foreground="{DynamicResource RamStatPercentBrush}" FontSize="13"/>
                        <TextBlock Text=" used)" Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- RAM Progress Bar -->
                <ProgressBar Grid.Row="1" 
                             Height="10" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="{Binding MemoryPercent}" 
                             Foreground="{DynamicResource ProgressBarFillBrush}" 
                             Background="{DynamicResource ProgressBarTrackBrush}" 
                             BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Tabbed List of Items -->
        <TabControl Grid.Row="3" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Margin="0,0,0,12">
            <!-- System Tweaks Tab -->
            <TabItem Header="{Binding SystemTweaksTabHeader}" MinWidth="145">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding SystemTweakItems}" ItemTemplate="{StaticResource DebloatItemTemplate}" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- Startup Apps Tab -->
            <TabItem Header="{Binding StartupTabHeader}" MinWidth="145">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding StartupItems}" ItemTemplate="{StaticResource DebloatItemTemplate}" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- Bloatware Tab -->
            <TabItem Header="{Binding BloatwareTabHeader}" MinWidth="135">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding BloatwareItems}" ItemTemplate="{StaticResource DebloatItemTemplate}" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- Windows Services Tab -->
            <TabItem Header="{Binding ServicesTabHeader}" MinWidth="170">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding ServiceItems}" ItemTemplate="{StaticResource DebloatItemTemplate}" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- User Installed Apps Tab -->
            <TabItem Header="{Binding UserAppsTabHeader}" MinWidth="185">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding UserAppItems}" ItemTemplate="{StaticResource DebloatItemTemplate}" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- Dedicated Full Undo & Revert Tab -->
            <TabItem Header="{Binding RevertTabHeader}" MinWidth="145" Margin="0">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Revert Toolbar -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource CardBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14,10" 
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="↩️ Full Undo &amp; Revert Center" 
                                           FontWeight="Bold" 
                                           FontSize="14" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Revert previously applied optimizations, restore registry tweaks, or re-enable stopped services." 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SelectAllRevertCommand}" 
                                        Content="Select All" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0" />

                                <Button Command="{Binding DeselectAllRevertCommand}" 
                                        Content="Clear All" 
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0" />

                                <Button Command="{Binding UndoSelectedCommand}" 
                                        Content="↩️ Revert Selected" 
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        FontSize="12"
                                        Padding="14,6" />

                                <Button Command="{Binding ClearHistoryCommand}" 
                                        Content="🗑️ Clear History" 
                                        Background="{DynamicResource TagAdminBackgroundBrush}" 
                                        Foreground="{DynamicResource TagAdminForegroundBrush}" 
                                        BorderBrush="{DynamicResource TagAdminBorderBrush}"
                                        BorderThickness="1" 
                                        FontWeight="SemiBold" 
                                        Padding="12,6" 
                                        Margin="8,0,0,0" 
                                        Cursor="Hand"
                                        ToolTip="Clear persistent JSON undo history from disk">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Empty State Notice -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource CardBackgroundBrush}" 
                            BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="40,30" 
                            VerticalAlignment="Top"
                            Visibility="{Binding HasNoRevertItems, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="✨" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No Applied Changes to Revert" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="When you apply optimizations, disable services, or modify startup entries, items that support rollback will appear here." 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       FontSize="13" 
                                       HorizontalAlignment="Center" 
                                       TextWrapping="Wrap" 
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- List of Revertable Items -->
                    <ScrollViewer Grid.Row="1" 
                                  VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasRevertItems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding RevertItems}" ItemTemplate="{StaticResource RevertItemTemplate}" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Controls -->
        <Border Grid.Row="4" 
                Background="{DynamicResource CardBackgroundBrush}" 
                BorderBrush="{DynamicResource CardBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="14,10" 
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SelectRecommendedCommand}" 
                            Content="⭐ Select Recommended" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" />

                    <Button Command="{Binding SelectAllCommand}" 
                            Content="Select All" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" />

                    <Button Command="{Binding DeselectAllCommand}" 
                            Content="Clear All" 
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <TextBlock Grid.Column="1" 
                           Text="{Binding ProgressText}" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center" 
                           TextTrimming="CharacterEllipsis" 
                           Margin="10,0"/>

                <Button Grid.Column="2" 
                        Command="{Binding ApplySelectedCommand}" 
                        IsEnabled="{Binding CanApplySelected, Mode=OneWay}"
                        Style="{StaticResource PrimaryActionButtonStyle}">
                    <TextBlock>
                        <Run Text="⚡ Apply Selected ("/>
                        <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                        <Run Text=" items)"/>
                    </TextBlock>
                </Button>
            </Grid>
        </Border>

        <!-- Execution Log Console -->
        <Border Grid.Row="5" 
                Background="{DynamicResource LogBackgroundBrush}" 
                BorderBrush="{DynamicResource LogBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📋 Activity Log" 
                           Foreground="{DynamicResource LogHeaderBrush}" 
                           FontSize="11" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,6"/>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Logs}" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Foreground="{DynamicResource LogForegroundBrush}" 
                         FontFamily="Consolas" 
                         FontSize="11" 
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Window Footer -->
        <Grid Grid.Row="6" Margin="4,8,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Windows Debloat &amp; RAM Optimizer" 
                       Foreground="{DynamicResource FooterTextBrush}" 
                       FontSize="11" 
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" 
                       Text="{Binding AppVersion, StringFormat='WinDebloat {0}'}" 
                       Foreground="{DynamicResource FooterVersionBrush}" 
                       FontSize="11" 
                       FontWeight="SemiBold" 
                       FontFamily="Consolas, Segoe UI"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
